{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PetCrew",
  "version": "0.1.0",
  "identifier": "app.petcrew.overlay",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PetCrew",
        "width": 520,
        "height": 760,
        "minWidth": 390,
        "minHeight": 620,
        "maxWidth": 900,
        "maxHeight": 1000,
        "resizable": true,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "shadow": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": false
  }
}
